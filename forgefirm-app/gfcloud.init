#!/bin/sh
### BEGIN INIT INFO
# Provides:          gfcloud
# Required-Start:    $local_fs $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Glowforge web-service controller (full cloud mode)
### END INIT INFO

# The controller lifecycle belongs to the forgectrl supervisor: it
# spawns the controller selected by controller_mode as a direct child
# (that relationship carries the pulse-device fd and death detection).
# This script remains only as a manual emergency stop.

case "$1" in
  start)
    echo "gfcloud is managed by forgectrl (POST /mode to switch controllers)"
    ;;
  stop)
    echo "Stopping gfcloud"
    pkill -f gfcloud.py 2>/dev/null
    ;;
  restart)
    $0 stop
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
